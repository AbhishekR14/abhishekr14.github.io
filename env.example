// README
// This is only a .env example
// Do not change this file, adding your GITHUB TOKEN here!
// Use cp or mv (like this: cp env.example .env), then edit .env with your GITHUB TOKEN.
// IMPORTANT: Don't forget to add to update your .gitignore with .env (to avoid making your key public!)

REACT_APP_GITHUB_TOKEN = "YOUR GITHUB TOKEN HERE"
USERNAME_GITHUB = "YOUR GITHUB USERNAME HERE"
// Set to true to fetch profile data from GitHub (remember to remove all components relying on GitHub data if set to false)
USE_GITHUB_DATA = "true"
// Set to your username in order to fetch blog data from Medium (otherwise, hardcoded values from Blogs.js are used)
MEDIUM_USERNAME = "YOU MEDIUM USERNAME HERE"

// ─── Chatbot ───────────────────────────────────────────────
// The site and the chat endpoint deploy together to Vercel, so the widget calls
// /api/chat on its own origin and needs no client-side config. These two are
// only needed for a split deploy (site and endpoint on different origins):
// REACT_APP_CHAT_API_URL = ""        // leave unset to use /api/chat

// Server-side ONLY. Never prefix these with REACT_APP_ - that would compile the
// key into the public browser bundle. Set them in the Vercel dashboard.
// OPENAI_API_KEY = "YOUR OPENAI API KEY HERE"
// CHAT_MODEL = ""                          // optional; defaults to gpt-4o-mini

// Rate limiting (Upstash Redis, free tier). Without these the endpoint refuses
// every request by design - an unmetered endpoint spends real money.
// UPSTASH_REDIS_REST_URL = "YOUR UPSTASH REST URL HERE"
// UPSTASH_REDIS_REST_TOKEN = "YOUR UPSTASH REST TOKEN HERE"

